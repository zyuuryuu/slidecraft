exports[`#392 段 0: SlideIR snapshot (parseMdReport — deck + parse notices) > samples/manuscript-01-business-proposal.md 1`] = `
{
  "deck": {
    "slides": [
      {
        "diagram": undefined,
        "layout": "auto",
        "mermaidBlock": undefined,
        "placeholders": [
          {
            "idx": "15",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "社内ナレッジ検索ツール「Hubble」導入提案",
                  },
                ],
              },
            ],
          },
          {
            "idx": "16",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "背景",
                  },
                ],
              },
            ],
          },
          {
            "idx": "1",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "近年、当社の事業拡大にともない、各部門が蓄積するドキュメントやノウハウの総量は急速に増加しています。営業資料、技術仕様書、過去の提案書、議事録といった情報資産は、いまや会社全体の競争力を支える基盤となっていますが、その保管場所は共有ストレージ、チャットツール、各種SaaS、そして個人のローカル環境へと際限なく分散しているのが実情です。結果として、必要な情報がどこにあるのかを把握している人が限られ、組織としての知識の再利用が十分に進んでいません。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "特に入社から日の浅いメンバーにとっては、誰に何を聞けばよいのかという初歩的なハードルが高く、本来であれば数分で解決するはずの疑問に半日を費やしてしまう場面も少なくありません。こうした状況は、個人の生産性を下げるだけでなく、ベテラン社員への問い合わせを集中させ、組織全体の時間を静かに浪費しています。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 課題",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "現状の最大の課題は、情報が「探せない」ことにあります。各ツールに個別の検索機能は備わっているものの、横断的に一度で探せる仕組みが存在しないため、利用者は複数のツールを行き来しながら手作業で情報を突き合わせる必要があります。さらに、検索がファイル名やタイトルの完全一致に依存しているため、表現の揺れや言い回しの違いによって、実際には存在する情報にたどり着けないケースが頻発しています。問い合わせ対応に追われる担当者の負担も看過できず、属人化したナレッジが退職とともに失われるリスクも年々高まっています。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 提案",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "そこで、社内に散在する情報資産を横断的に検索できるナレッジ検索ツール「Hubble」の導入を提案します。Hubbleは主要な社内ツールと連携し、自然言語による問いかけに対して関連性の高い情報を要約とともに提示します。キーワードの完全一致に頼らず文意を理解した検索を行うため、表現の揺れに強く、目的の情報へ短時間で到達できます。アクセス権限は既存の認証基盤と統合され、各メンバーが本来閲覧できる範囲のみを対象とするため、情報セキュリティを損なうことなく運用できます。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 期待効果",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "検索時間削減: 1件あたり平均15分から2分へ",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "問い合わせ件数: 月間でおよそ40パーセント減",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "新人立ち上がり期間: 3週間から2週間へ短縮",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "対象ドキュメント数: 初期連携で約12万件",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "想定ROI: 導入12カ月で投資回収",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 導入スケジュール",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "導入は段階的に進める計画です。まず最初の1カ月で対象データソースの棚卸しと権限設計を行い、続く2カ月でパイロット部門を選定して試験運用を実施します。そこで得られたフィードバックをもとに検索精度と運用ルールを調整したうえで、4カ月目以降に全社展開へと移行します。展開後も利用状況を継続的にモニタリングし、四半期ごとに改善サイクルを回していく方針です。",
                  },
                ],
              },
            ],
          },
        ],
        "sourceLineEnd": 28,
        "sourceLineStart": 1,
      },
    ],
    "template": undefined,
  },
  "notices": [],
}
`;

exports[`#392 段 0: SlideIR snapshot (parseMdReport — deck + parse notices) > samples/manuscript-02-tech-report.md 1`] = `
{
  "deck": {
    "slides": [
      {
        "diagram": undefined,
        "layout": "auto",
        "mermaidBlock": undefined,
        "placeholders": [
          {
            "idx": "15",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "決済API 負荷試験レポート — 2026年Q2",
                  },
                ],
              },
            ],
          },
          {
            "idx": "16",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "試験条件と環境",
                  },
                ],
              },
            ],
          },
          {
            "idx": "1",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "本レポートは、決済処理APIに対して実施した負荷試験の結果と、その分析、ならびにキャッシュ層およびコネクションプール設定の見直しによる改善効果をまとめたものである。試験は本番同等のステージング環境で行い、ピーク商戦期を想定したトラフィックを再現した。対象期間中、約3週間にわたって計測と段階的なチューニングを繰り返している。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "試験対象はNode.js製の決済オーケストレーションサービスであり、背後にPostgreSQL 16とRedis 7を配置している。負荷生成にはk6を用い、仮想ユーザを段階的に増加させながら、5分間のランプアップと20分間の定常負荷を組み合わせたシナリオを実行した。各リクエストは認証、在庫引当、与信照会、確定の4ステップを含む現実的なフローを模している。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "想定ピーク: 8,000 RPS",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "仮想ユーザ数: 12,000",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "試験時間: 25分（ランプ5分＋定常20分）",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 改善前の計測結果",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "初回計測では、定常負荷の後半で明確な性能劣化が観測された。とくにp99レイテンシが急峻に悪化し、データベースのコネクション枯渇に起因すると見られるエラーが断続的に発生した。長時間にわたるトレースを確認したところ、与信照会ステップで外部APIへの同期待機が積み上がり、プール内の接続が解放されないまま保持され続けるパターンが支配的であった。これがスループットの頭打ちと末尾レイテンシ膨張の主因と判断している。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "p50レイテンシ: 142ms",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "p99レイテンシ: 1,820ms",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "スループット: 4,300 RPS",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "エラー率: 3.7%",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "推定インフラコスト: 月額 ¥1,480,000",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 改善施策",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "主な変更は三点である。第一に、与信照会を非同期化し、外部API呼び出しにタイムアウトとサーキットブレーカーを導入した。第二に、Redisを用いた在庫引当結果の短期キャッシュを追加し、重複照会を削減した。第三に、PostgreSQLのコネクションプール上限とアイドル回収間隔を再設定し、PgBouncerをトランザクションプーリングモードで前段に配置した。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 改善後の計測結果",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "同一シナリオで再計測したところ、末尾レイテンシとエラー率が大幅に改善した。とくにp99の改善幅が大きく、定常負荷の後半でも安定して目標スループットを維持できるようになった。コスト面でもインスタンス台数を削減できたため、月額負担が軽くなっている。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "p50レイテンシ: 88ms",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "p99レイテンシ: 410ms",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "スループット: 7,650 RPS",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "エラー率: 0.4%",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "推定インフラコスト: 月額 ¥1,060,000",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 結論と今後",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "今回のチューニングにより、スループットは約1.8倍、p99レイテンシは約4.4分の1に短縮され、想定ピークに対する余裕度が確保できた。残課題として、与信照会の外部依存が依然としてボトルネックの起点になりうる点が挙げられる。次フェーズでは照会結果の予測キャッシュとリージョン分散を検討し、さらなる末尾レイテンシの安定化を目指す。",
                  },
                ],
              },
            ],
          },
        ],
        "sourceLineEnd": 40,
        "sourceLineStart": 1,
      },
    ],
    "template": undefined,
  },
  "notices": [],
}
`;

exports[`#392 段 0: SlideIR snapshot (parseMdReport — deck + parse notices) > samples/manuscript-03-howto-guide.md 1`] = `
{
  "deck": {
    "slides": [
      {
        "diagram": undefined,
        "layout": "auto",
        "mermaidBlock": undefined,
        "placeholders": [
          {
            "idx": "15",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "新メンバーの開発環境セットアップガイド",
                  },
                ],
              },
            ],
          },
          {
            "idx": "16",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "はじめに",
                  },
                ],
              },
            ],
          },
          {
            "idx": "1",
            "paragraphs": [
              {
                "segments": [
                  {
                    "text": "このドキュメントは、新しくチームに参加したエンジニアが、最初の一日でローカル開発環境を立ち上げ、最初のプルリクエストを出せるようになるまでの道のりをまとめたものです。手順そのものよりも「なぜそうするのか」を理解してもらうことを大切にしているので、つまずいたときは遠慮なくチームの誰かに声をかけてください。私たちは質問を歓迎する文化を持っています。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "私たちのプロダクトはデスクトップアプリケーションであり、ビルドにはいくつかの外部ツールチェーンが必要です。最初は依存関係が多く感じるかもしれませんが、一度そろえてしまえば日々の開発は驚くほど快適になります。焦らず、一歩ずつ進めていきましょう。所要時間はおよそ半日を見込んでおくと安心です。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 環境を整える",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "まずは土台となるツール群をインストールします。順番が前後すると後の手順でエラーが出ることがあるため、次の流れに沿って進めてください。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "bullet": true,
                "ordered": true,
                "segments": [
                  {
                    "text": "まず社内アカウントを発行してもらい、GitHub Organization への招待を受け取ります。招待メールが届いていない場合はオンボーディング担当に連絡してください。",
                  },
                ],
              },
              {
                "bullet": true,
                "ordered": true,
                "segments": [
                  {
                    "text": "次に Node.js と Rust のツールチェーンをインストールします。バージョンはリポジトリ直下の設定ファイルに固定されているので、それに合わせてください。",
                  },
                ],
              },
              {
                "bullet": true,
                "ordered": true,
                "segments": [
                  {
                    "text": "続いてリポジトリをクローンし、依存パッケージをインストールします。ここで時間がかかるのは正常です。",
                  },
                ],
              },
              {
                "bullet": true,
                "ordered": true,
                "segments": [
                  {
                    "text": "最後に環境変数のテンプレートをコピーし、必要な値を自分用に書き換えます。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "ここまで終えると、ローカルでアプリを起動する準備が整います。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 動作を確認する",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "セットアップが正しく完了したかは、実際に動かして確かめるのが一番確実です。開発サーバーを起動し、ブラウザでプレビュー画面が表示されることを確認してください。あわせてテストスイートを一度走らせ、すべて緑になることを見届けます。もしテストが落ちる場合、それは多くの場合あなたのミスではなく、環境のどこかが噛み合っていないサインです。エラーメッセージをそのままチームに共有してくれれば、原因をすぐに切り分けられます。",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "## 最初の一歩",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "",
                  },
                ],
              },
              {
                "segments": [
                  {
                    "text": "環境が動いたら、ウォームアップとして小さな修正に挑戦してみましょう。タイポの修正やコメントの追記など、ごく軽いもので構いません。ブランチを切り、変更をコミットし、プルリクエストを作成する。この一連の流れを体験することが、チームの開発リズムをつかむ何よりの近道です。最初のレビューを楽しみにしています。",
                  },
                ],
              },
            ],
          },
        ],
        "sourceLineEnd": 27,
        "sourceLineStart": 1,
      },
    ],
    "template": undefined,
  },
  "notices": [],
}
`;

